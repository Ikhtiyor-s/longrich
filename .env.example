# Copy to .env and fill in for local development.
# No real values committed here — see docs/architecture for where each secret
# comes from. DATABASE_URL is required by `prisma generate`/`migrate`.
#
# docker-compose.dev.yml (T-G0-2) reads POSTGRES_*/MINIO_*/REDIS_PORT/etc. below
# for the dev infra containers. api/worker/migration-runner containers build
# their own DATABASE_URL/REDIS_URL pointing at the in-network service names
# (postgres/redis), not at these localhost values — host-side commands
# (pnpm db:generate, pnpm db:migrate:dev, this file's DATABASE_URL) use
# localhost + the mapped port instead.
# If you change POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_PORT below, update the
# DATABASE_URL line to match — it is not auto-derived from the pieces above.

DATABASE_URL="postgresql://longrich:longrich@localhost:5432/longrich?schema=public"

# --- Postgres (docker-compose.dev.yml) ---
POSTGRES_USER=longrich
POSTGRES_PASSWORD=longrich
POSTGRES_DB=longrich
POSTGRES_PORT=5432

# --- Redis (docker-compose.dev.yml) ---
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# --- MinIO (docker-compose.dev.yml) ---
MINIO_ROOT_USER=longrich
MINIO_ROOT_PASSWORD=longrich_minio_dev
MINIO_BUCKET=longrich-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host-side value (apps/api/src/common/storage/storage.config.ts, T-G1-3) —
# the api/worker containers set their own MINIO_ENDPOINT=http://minio:9000
# (in-network service name) directly in docker-compose.dev.yml, same
# localhost-vs-service-name split DATABASE_URL/REDIS_URL already use.
MINIO_ENDPOINT="http://localhost:9000"

# --- Object storage signed URLs (apps/api/src/common/storage, T-G1-3) ---
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Seller KYB document upload (apps/api/src/modules/sellers/documents, T-G1-3) ---
# TZ §28 names the requirement ("file MIME+size validation") but not the
# exact allowed list/limit — config-driven, not a hardcoded business rule.
SELLER_DOCUMENT_ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png"
SELLER_DOCUMENT_MAX_SIZE_BYTES=10485760

# --- OpenSearch (docker-compose.dev.yml, optional/profile "search") ---
OPENSEARCH_PORT=9200

# --- apps/api ---
API_PORT=3000

# --- Auth / OTP / sessions (T-G0-4) ---
# All TTL/attempt defaults below are architecture placeholders (TZ §28 flags the OTP
# TTL/attempt numbers as "proposals," not confirmed business rules) — see
# docs/architecture/g0-design-notes.md §1.
#
# JWT_SECRET / OTP_HMAC_SECRET below are THROWAWAY, randomly generated, DEV-AND-CI-ONLY
# values (generated with `openssl rand -hex 32` / Node's crypto.randomBytes) — they are
# not production secrets and carry no confidentiality requirement beyond "don't reuse
# them anywhere real." A real deployment MUST set its own JWT_SECRET/OTP_HMAC_SECRET via
# the secret manager/environment; apps/api/src/modules/identity/config/auth.config.ts
# (G0 QA review blocker #2) now hard-fails startup if either is unset/blank outside
# NODE_ENV=development/test — there is no silent insecure fallback outside those two.
# Regenerate your own local values any time with:
#   openssl rand -hex 32
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_HMAC_SECRET=12d6ad37cf3b16005901532d42040058b6d5c13025f24577f988a9b65bcb37a4
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PHONE_15MIN=5
OTP_RATE_LIMIT_DEVICE_HOUR=10
OTP_RATE_LIMIT_IP_HOUR=20
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_SECRET=c7b71140d93939c215166f2c6a0d7051e0de294e94e1b459879bcd4bdc2a7dff
JWT_ISSUER=longrich-marketplace
