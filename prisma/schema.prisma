// Longrich Marketplace — G0+G1 schema (identity, admin RBAC, outbox/idempotency/inbox,
// audit, seller onboarding). Frozen contract: see docs/architecture/g0-design-notes.md
// for the "why" behind every deviation from the TZ's literal column lists (outbox
// reconciliation, admin_roles.scope, audit_logs immutability trigger).
// See docs/adr/ADR-001-architecture.md module list and docs/traceability.md milestones.
//
// Maps to migrations against this one cumulative schema:
//   0001_identity_rbac_outbox         (T-G0-3): User, AdminRole, AdminPermission,
//                                     AdminRolePermission, AdminMember, AuditLog,
//                                     OutboxEvent, IdempotencyKey, InboxProcessedEvent
//   0002_auth_sessions                (T-G0-4): OtpChallenge, Session, RefreshToken
//   0003_mutable_entities_updated_at  (G0 QA review major #7): adds updated_at to
//                                     RefreshToken + OutboxEvent, the two mutable-
//                                     after-create G0 tables that were missing it.
//   0004_seller_onboarding            (T-G1-1): Seller, SellerApplication,
//                                     SellerDocument, SellerMember, SellerBankAccount,
//                                     SellerContract.
//   0005_seller_profile_fields        (T-G1-6): Seller.description/logoObjectKey/
//                                     workingHours/deliveryTerms.
//   0006_seller_bank_account_review   (T-G1-8): SellerBankAccount.reviewerId/
//                                     reviewedAt (approve/reject attribution,
//                                     reusing T-G1-5's reviewer-recording
//                                     convention — no new status enum).
//   0007_seller_bank_account_raw_reference_rename (G1 QA review major #4):
//                                     SellerBankAccount.encryptedReference ->
//                                     rawReference, naming-only — no real
//                                     encryption-at-rest exists or is added.
//   0008_catalog_offers               (T-G2-1): Category, CategoryAttribute,
//                                     Brand, Product, ProductVariant,
//                                     ProductAttributeValue, ProductIdentifier,
//                                     SellerOffer, OfferPriceHistory,
//                                     ProductMedia, ProductMergeCase,
//                                     ModerationCase, ModerationDecision.
//                                     Field list frozen by
//                                     docs/architecture/api-contract-g2.md
//                                     ("Prisma field reference" section),
//                                     which fills gaps T-G2-1's own ticket
//                                     text left open — see that doc for the
//                                     per-table rationale.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "platform", "commerce"]
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@schema("public")
}

enum Locale {
  UZ
  RU

  @@schema("public")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  phone           String     @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz
  status          UserStatus @default(ACTIVE)
  locale          Locale     @default(UZ)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  otpChallenges              OtpChallenge[]
  sessions                   Session[]
  adminMembers               AdminMember[]
  sellerMemberships          SellerMember[]
  reviewedSellerApplications SellerApplication[] @relation("SellerApplicationReviewer")
  reviewedSellerBankAccounts SellerBankAccount[] @relation("SellerBankAccountReviewer")

  // users(phone) hot index (TZ §18/§30) is satisfied by the @unique constraint's
  // backing index — no separate @@index needed.
  @@map("users")
  @@schema("public")
}

enum OtpChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED

  @@schema("public")
}

model OtpChallenge {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String?            @map("user_id") @db.Uuid
  phone         String             @db.VarChar(20)
  purpose       String             @db.VarChar(32)
  codeHash      String             @map("code_hash")
  attemptsCount Int                @default(0) @map("attempts_count")
  maxAttempts   Int                @default(5) @map("max_attempts")
  status        OtpChallengeStatus @default(PENDING)
  deviceId      String?            @map("device_id")
  ipHash        String?            @map("ip_hash")
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz
  verifiedAt    DateTime?          @map("verified_at") @db.Timestamptz
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([phone, status, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
  @@schema("public")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@schema("public")
}

model Session {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  deviceId      String?       @map("device_id")
  userAgent     String?       @map("user_agent")
  ipHash        String?       @map("ip_hash")
  status        SessionStatus @default(ACTIVE)
  lastUsedAt    DateTime?     @map("last_used_at") @db.Timestamptz
  revokedAt     DateTime?     @map("revoked_at") @db.Timestamptz
  revokedReason String?       @map("revoked_reason")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId, status])
  @@map("sessions")
  @@schema("public")
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED

  @@schema("public")
}

model RefreshToken {
  id          String             @id @default(uuid()) @db.Uuid
  sessionId   String             @map("session_id") @db.Uuid
  tokenHash   String             @unique @map("token_hash")
  status      RefreshTokenStatus @default(ACTIVE)
  issuedAt    DateTime           @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz
  usedAt      DateTime?          @map("used_at") @db.Timestamptz
  rotatedToId String?            @unique @map("rotated_to_id") @db.Uuid
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  session     Session       @relation(fields: [sessionId], references: [id])
  rotatedTo   RefreshToken? @relation("RefreshTokenChain", fields: [rotatedToId], references: [id])
  rotatedFrom RefreshToken? @relation("RefreshTokenChain")

  @@index([sessionId, status])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Admin RBAC (ADM-007) — see g0-design-notes.md for the `scope` extensibility
// decision and the seed data this is expected to carry.
// ---------------------------------------------------------------------------

model AdminRole {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String
  // TEXT, not a Prisma enum, deliberately: G0 only allows 'GLOBAL' (enforced via
  // a CHECK constraint added in migration SQL, not expressible in schema.prisma
  // DSL directly). G1 widens the CHECK to add 'SELLER', G3 adds 'WAREHOUSE' —
  // additive, non-breaking. See g0-design-notes.md "RBAC scope extensibility".
  scope       String   @default("GLOBAL") @db.VarChar(32)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions AdminRolePermission[]
  adminMembers    AdminMember[]

  @@map("admin_roles")
  @@schema("public")
}

model AdminPermission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(64)
  action      String   @db.VarChar(64)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions AdminRolePermission[]

  @@unique([resource, action])
  @@map("admin_permissions")
  @@schema("public")
}

model AdminRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       AdminRole       @relation(fields: [roleId], references: [id])
  permission AdminPermission @relation(fields: [permissionId], references: [id])

  // Composite PK doubles as the tenant-scope-first composite index pattern
  // T-G0-3 asks to demonstrate (role_id first, matching seller_members(seller_id,user_id)'s
  // own ordering convention for when that table lands in G1).
  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
  @@schema("public")
}

enum AdminMemberStatus {
  ACTIVE
  SUSPENDED

  @@schema("public")
}

model AdminMember {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  roleId    String            @map("role_id") @db.Uuid
  status    AdminMemberStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  user User      @relation(fields: [userId], references: [id])
  role AdminRole @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@map("admin_members")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Audit (ADM-008) — append-only. Immutability is enforced by a DB trigger,
// not application discipline alone; see g0-design-notes.md for the exact
// trigger SQL and the reasoning for choosing DB-level over app-level.
//
// actor_id is intentionally NOT a foreign key: audit rows must survive even
// if the referenced user/admin identity is later modified or anonymized
// (see docs/open-questions.md #9, data residency/privacy), and actor_type
// SYSTEM/SERVICE actors have no users.id at all.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorType  String   @map("actor_type") @db.VarChar(16)
  action     String   @db.VarChar(128)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  requestId  String?  @map("request_id")
  traceId    String?  @map("trace_id")
  ipHash     String?  @map("ip_hash")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([actorId])
  @@map("audit_logs")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Platform / commerce cross-cutting infra (TZ §30)
// ---------------------------------------------------------------------------

// Column set and indexes are a reconciliation of TZ §18's hot-index list
// (status, created_at) and TZ §30's literal column list (which omits status
// but specifies the published_at index). See g0-design-notes.md
// "Outbox index reconciliation" for the full reasoning — short version: both
// indexes are kept because the dead-letter-queue requirement (TZ §19) needs
// a richer status enum than a nullable published_at timestamp alone can express.
enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER

  @@schema("platform")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.VarChar(64)
  eventType     String       @map("event_type") @db.VarChar(128)
  payload       Json
  status        OutboxStatus @default(PENDING)
  occurredAt    DateTime     @map("occurred_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz
  retryCount    Int          @default(0) @map("retry_count")
  nextAttemptAt DateTime?    @map("next_attempt_at") @db.Timestamptz
  lastError     String?      @map("last_error")
  lockedBy      String?      @map("locked_by")
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  inboxEntries InboxProcessedEvent[]

  @@index([status, createdAt])
  @@index([publishedAt])
  @@map("outbox_events")
  @@schema("platform")
}

model InboxProcessedEvent {
  consumer    String   @db.VarChar(128)
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  outboxEvent OutboxEvent @relation(fields: [eventId], references: [id])

  @@id([consumer, eventId])
  @@map("inbox_processed_events")
  @@schema("platform")
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@schema("commerce")
}

model IdempotencyKey {
  scope           String               @db.VarChar(64)
  key             String               @db.VarChar(128)
  requestHash     String               @map("request_hash")
  responsePayload Json?                @map("response_payload")
  status          IdempotencyKeyStatus @default(IN_PROGRESS)
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("commerce")
}

// ---------------------------------------------------------------------------
// Sellers — onboarding/KYB, staff, bank reference, contract acceptance
// (ADR-001 module 2, G1 — T-G1-1). Placed in the "public" schema, same as
// every G0 model: ADR-001 explicitly leaves per-module schema placement
// beyond platform/commerce to "that module's own architect pass" and no such
// decision has been made for `sellers` yet, so this follows G0's existing
// default rather than inventing a new schema unasked.
//
// legal_type is deliberately NOT a native Prisma enum: the real set of
// Uzbekistan legal entity types is not legally confirmed yet
// (docs/open-questions.md #6) — a closed DB enum would need a destructive
// migration to correct once that review lands, so it is a VARCHAR validated
// against an app-level/config allowlist instead. seller_documents.type
// follows the same reasoning (document category list tied to the same open
// legal review) and is also a plain VARCHAR, not an enum.
// ---------------------------------------------------------------------------

enum SellerStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  NEEDS_CHANGES
  REJECTED
  SUSPENDED

  @@schema("public")
}

// Application-level review workflow only (TZ §29) — ACTIVE/SUSPENDED are
// post-approval states that live on the Seller entity itself (SellerStatus),
// not on a single application attempt.
enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  NEEDS_CHANGES
  REJECTED

  @@schema("public")
}

enum SellerMemberRole {
  OWNER
  MANAGER
  OPERATOR

  @@schema("public")
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("public")
}

model Seller {
  id            String       @id @default(uuid()) @db.Uuid
  legalName     String       @map("legal_name") @db.VarChar(255)
  taxId         String       @map("tax_id") @db.VarChar(64)
  legalType     String       @map("legal_type") @db.VarChar(32)
  displayName   String       @map("display_name") @db.VarChar(120)
  status        SellerStatus @default(DRAFT)
  // T-G1-6 shop-profile fields (TZ §06 SEL-004 / spreadsheet AC-SEL-004 gloss
  // "Profil, logotip, working hours, delivery terms"). All nullable, no
  // default: T-G1-1 sellers already exist with none of these set, and there
  // is no sensible non-null default for any of them. logoObjectKey is an
  // object-storage reference only (ADR-001 "no file bytes in Postgres"),
  // same shape as seller_documents.object_key — not a presigned-upload
  // resource of its own; this ticket does not add a logo upload endpoint.
  // All four are "publish-affecting" (customer-facing storefront content,
  // TZ §29 "seller cannot publish while non-ACTIVE") except displayName,
  // which keeps its pre-existing cross-status editability from SEL-001's own
  // write path (seller_applications PATCH, DRAFT-only) — see profile.service.ts.
  description   String?      @db.Text
  logoObjectKey String?      @map("logo_object_key") @db.Text
  workingHours  String?      @map("working_hours") @db.Text
  deliveryTerms String?      @map("delivery_terms") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  version       Int          @default(1)

  applications      SellerApplication[]
  documents         SellerDocument[]
  members           SellerMember[]
  bankAccounts      SellerBankAccount[]
  contracts         SellerContract[]
  offers            SellerOffer[]
  catalogImportJobs CatalogImportJob[]

  @@index([status])
  @@map("sellers")
  @@schema("public")
}

model SellerApplication {
  id         String                  @id @default(uuid()) @db.Uuid
  sellerId   String                  @map("seller_id") @db.Uuid
  status     SellerApplicationStatus @default(DRAFT)
  reviewerId String?                 @map("reviewer_id") @db.Uuid
  reason     String?
  // Applicant contact info captured at intake (T-G1-2); kept as a versioned
  // snapshot JSON rather than new relational columns, consistent with
  // ADR-001's "JSON only for snapshots and versioned configs" rule.
  contacts   Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version   Int      @default(1)

  seller   Seller @relation(fields: [sellerId], references: [id])
  reviewer User?  @relation("SellerApplicationReviewer", fields: [reviewerId], references: [id])

  @@index([sellerId, status])
  @@map("seller_applications")
  @@schema("public")
}

model SellerDocument {
  id        String  @id @default(uuid()) @db.Uuid
  sellerId  String  @map("seller_id") @db.Uuid
  type      String  @db.VarChar(64)
  // Object-storage reference only (S3/MinIO key) — no file bytes in Postgres,
  // per ADR-001's object storage decision.
  objectKey String  @map("object_key")
  fileName  String? @map("file_name") @db.VarChar(255)
  mimeType  String  @map("mime_type") @db.VarChar(128)
  sizeBytes Int     @map("size_bytes")

  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  scannedAt          DateTime?                  @map("scanned_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version   Int      @default(1)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, type])
  @@map("seller_documents")
  @@schema("public")
}

model SellerMember {
  id        String           @id @default(uuid()) @db.Uuid
  sellerId  String           @map("seller_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      SellerMemberRole
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  version   Int              @default(1)

  seller Seller @relation(fields: [sellerId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  // TZ §18/§30 hot index, named exactly as both sections list it:
  // seller_members(seller_id, user_id). Unique, not just indexed, because a
  // user holds exactly one role per seller — same tenant-scope-first
  // composite pattern admin_role_permissions already demonstrated in G0.
  @@unique([sellerId, userId])
  @@index([userId])
  @@map("seller_members")
  @@schema("public")
}

model SellerBankAccount {
  id           String    @id @default(uuid()) @db.Uuid
  sellerId     String    @map("seller_id") @db.Uuid
  // TEXT, not a numeric type — must never normalize away a leading zero
  // (TZ §28). Named rawReference (not encryptedReference, renamed in
  // migration 0007 — G1 QA review major #4): there is NO real encryption-
  // at-rest on this column today, only response-layer masking
  // (bank-accounts.mapper.ts's maskBankReference). The old name misleadingly
  // implied the value was already encrypted. Encryption-at-rest is a known,
  // tracked pre-production gap (docs/open-questions.md), not solved here —
  // this rename only stops a future reader from assuming it already
  // happened.
  rawReference String    @map("raw_reference") @db.Text
  verified     Boolean   @default(false)
  // T-G1-8 (SEL-008/§28/§34 "sensitive bank changes trigger review"):
  // reviewer attribution, reusing T-G1-5's reviewer_id/reviewer-recording
  // convention (seller_applications.reviewer_id) rather than inventing a
  // parallel review-case table or a new status enum — see this ticket's own
  // design note. No status column is added: verified stays a plain boolean,
  // and reviewedAt IS NULL is what distinguishes "never reviewed" (pending)
  // from "reviewed" (verified=true -> approved, verified=false -> rejected).
  reviewerId   String?   @map("reviewer_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  version      Int       @default(1)

  seller   Seller @relation(fields: [sellerId], references: [id])
  reviewer User?  @relation("SellerBankAccountReviewer", fields: [reviewerId], references: [id])

  @@index([sellerId])
  @@map("seller_bank_accounts")
  @@schema("public")
}

model SellerContract {
  id         String   @id @default(uuid()) @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  version    Int
  signedKey  String   @map("signed_key")
  acceptedAt DateTime @map("accepted_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  // Append-only: "historical [contract] versions kept" (TZ §28) — never
  // overwritten, so no updated_at/version column here, same immutability
  // shape as AuditLog above.
  @@unique([sellerId, version])
  @@map("seller_contracts")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Global Catalog & Offers (ADR-001 modules `catalog`/`offers`, G2 — T-G2-1).
// Placed in the "public" schema, same reasoning as Sellers above: ADR-001
// leaves per-module schema placement beyond platform/commerce to that
// module's own architect pass, and no decision moves catalog/offers out of
// G0/G1's existing default.
//
// category_attributes.type, seller_offers.currency, seller_offers.fulfillment_mode
// are VARCHAR app-allowlists, not native Prisma enums — the full value sets
// aren't finalized (TZ never closes the rule-type list; WMS fulfillment
// modes land in G3/G6; currency is UZS-only for MVP but kept extensible),
// same reasoning as Seller.legalType above.
//
// Field list, schema placement of moderation_cases/moderation_decisions, and
// every gap this ticket's own prose left open are frozen by
// docs/architecture/api-contract-g2.md's "Prisma field reference" section —
// see that doc, not re-derived here.
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  ARCHIVED

  @@schema("public")
}

model Category {
  id                    String         @id @default(uuid()) @db.Uuid
  parentId              String?        @map("parent_id") @db.Uuid
  slug                  String         @unique @db.VarChar(255)
  name                  String         @db.VarChar(255)
  status                CategoryStatus @default(ACTIVE)
  requiresCertification Boolean        @default(false) @map("requires_certification")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  version               Int            @default(1)

  parent             Category?           @relation("CategoryParent", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryParent")
  categoryAttributes CategoryAttribute[]
  products           Product[]

  @@index([parentId])
  @@map("categories")
  @@schema("public")
}

model CategoryAttribute {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  key        String   @db.VarChar(64)
  label      String   @db.VarChar(255)
  type       String   @db.VarChar(32)
  required   Boolean  @default(false)
  validation Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version    Int      @default(1)

  category        Category                @relation(fields: [categoryId], references: [id])
  attributeValues ProductAttributeValue[]

  @@unique([categoryId, key])
  @@map("category_attributes")
  @@schema("public")
}

model Brand {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(255)
  slug          String   @unique @db.VarChar(255)
  logoObjectKey String?  @map("logo_object_key") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version       Int      @default(1)

  products Product[]

  @@map("brands")
  @@schema("public")
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  ARCHIVED

  @@schema("public")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  brandId     String?       @map("brand_id") @db.Uuid
  title       String        @db.VarChar(255)
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)
  canonicalId String?       @map("canonical_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  version     Int           @default(1)

  category          Category           @relation(fields: [categoryId], references: [id])
  brand             Brand?             @relation(fields: [brandId], references: [id])
  canonicalProduct  Product?           @relation("ProductMergeRedirect", fields: [canonicalId], references: [id])
  mergedProducts    Product[]          @relation("ProductMergeRedirect")
  variants          ProductVariant[]
  media             ProductMedia[]
  winningMergeCases ProductMergeCase[] @relation("MergeCaseWinningProduct")
  losingMergeCases  ProductMergeCase[] @relation("MergeCaseLosingProduct")
  catalogImportRows CatalogImportRow[]

  @@index([categoryId, status])
  @@map("products")
  @@schema("public")
}

enum VariantStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  ARCHIVED

  @@schema("public")
}

model ProductVariant {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  options     Json
  optionsHash String        @map("options_hash") @db.VarChar(64)
  status      VariantStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  version     Int           @default(1)

  product         Product                 @relation(fields: [productId], references: [id])
  attributeValues ProductAttributeValue[]
  identifiers     ProductIdentifier[]
  media           ProductMedia[]
  offers          SellerOffer[]

  @@unique([productId, optionsHash])
  @@map("product_variants")
  @@schema("public")
}

model ProductAttributeValue {
  id                  String   @id @default(uuid()) @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  categoryAttributeId String   @map("category_attribute_id") @db.Uuid
  value               Json
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version             Int      @default(1)

  variant           ProductVariant    @relation(fields: [variantId], references: [id])
  categoryAttribute CategoryAttribute @relation(fields: [categoryAttributeId], references: [id])

  @@unique([variantId, categoryAttributeId])
  @@map("product_attribute_values")
  @@schema("public")
}

enum IdentifierType {
  GTIN
  EAN
  UPC
  MXIK

  @@schema("public")
}

model ProductIdentifier {
  id                    String         @id @default(uuid()) @db.Uuid
  variantId             String         @map("variant_id") @db.Uuid
  type                  IdentifierType
  value                 String         @db.VarChar(64)
  classificationVersion String?        @map("classification_version") @db.VarChar(32)
  createdBy             String         @map("created_by") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id])

  // Append-only (confirmed by T-G2-1 / api-contract-g2.md) — no updated_at/
  // version. (type, value) hot index exactly as TZ §18/§30 name it.
  @@index([type, value])
  @@map("product_identifiers")
  @@schema("public")
}

enum OfferStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED

  @@schema("public")
}

model SellerOffer {
  id              String      @id @default(uuid()) @db.Uuid
  sellerId        String      @map("seller_id") @db.Uuid
  variantId       String      @map("variant_id") @db.Uuid
  // DB/Prisma column stays `sku`; the wire/DTO field is `seller_sku` — see
  // api-contract-g2.md "Inconsistencies resolved" #2. The rename is the
  // offers mapper's job, not this column's.
  sku             String      @db.VarChar(128)
  priceMinor      BigInt      @map("price_minor")
  currency        String      @db.VarChar(8)
  fulfillmentMode String      @map("fulfillment_mode") @db.VarChar(32)
  status          OfferStatus @default(DRAFT)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  version         Int         @default(1)

  seller            Seller              @relation(fields: [sellerId], references: [id])
  variant           ProductVariant      @relation(fields: [variantId], references: [id])
  priceHistory      OfferPriceHistory[]
  catalogImportRows CatalogImportRow[]

  // price_minor > 0 is enforced by a raw-SQL CHECK constraint added in this
  // migration's migration.sql (not expressible in schema.prisma DSL), same
  // pattern as admin_roles.scope's CHECK in 0001.
  @@unique([sellerId, sku])
  @@index([sellerId, variantId])
  @@map("seller_offers")
  @@schema("public")
}

model OfferPriceHistory {
  id            String   @id @default(uuid()) @db.Uuid
  offerId       String   @map("offer_id") @db.Uuid
  oldPriceMinor BigInt?  @map("old_price_minor")
  newPriceMinor BigInt   @map("new_price_minor")
  changedBy     String   @map("changed_by") @db.Uuid
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz

  offer SellerOffer @relation(fields: [offerId], references: [id])

  // Append-only (confirmed) — no updated_at/version.
  @@index([offerId, changedAt])
  @@map("offer_price_history")
  @@schema("public")
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

model ProductMedia {
  id               String                @id @default(uuid()) @db.Uuid
  productId        String                @map("product_id") @db.Uuid
  variantId        String?               @map("variant_id") @db.Uuid
  objectKey        String                @map("object_key") @db.Text
  position         Int                   @default(0)
  mimeType         String                @map("mime_type") @db.VarChar(128)
  moderationStatus MediaModerationStatus @default(PENDING) @map("moderation_status")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  version          Int                   @default(1)

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@map("product_media")
  @@schema("public")
}

enum MergeCaseStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

model ProductMergeCase {
  id                       String          @id @default(uuid()) @db.Uuid
  winningProductId         String          @map("winning_product_id") @db.Uuid
  losingProductId          String          @map("losing_product_id") @db.Uuid
  identifierType           String          @map("identifier_type") @db.VarChar(16)
  identifierValue          String          @map("identifier_value") @db.VarChar(64)
  status                   MergeCaseStatus @default(PENDING)
  manualResolutionRequired Boolean         @default(false) @map("manual_resolution_required")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  version                  Int             @default(1)

  winningProduct Product @relation("MergeCaseWinningProduct", fields: [winningProductId], references: [id])
  losingProduct  Product @relation("MergeCaseLosingProduct", fields: [losingProductId], references: [id])

  @@unique([winningProductId, losingProductId, identifierValue])
  @@map("product_merge_cases")
  @@schema("public")
}

// moderation_cases/moderation_decisions: entity_type/entity_id are a generic
// polymorphic pair (no FK — reused across product/product_variant/
// product_media/offer, per api-contract-g2.md). moderation_cases has no
// `version` in G2 — the CAS check G2 tests live on the underlying product/
// variant/offer row, not on this row.
model ModerationCase {
  id         String    @id @default(uuid()) @db.Uuid
  entityType String    @map("entity_type") @db.VarChar(32)
  entityId   String    @map("entity_id") @db.Uuid
  status     String    @default("OPEN") @db.VarChar(16)
  openedAt   DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  decisions ModerationDecision[]

  @@index([entityType, status])
  @@map("moderation_cases")
  @@schema("public")
}

model ModerationDecision {
  id               String   @id @default(uuid()) @db.Uuid
  entityType       String   @map("entity_type") @db.VarChar(32)
  entityId         String   @map("entity_id") @db.Uuid
  moderationCaseId String?  @map("moderation_case_id") @db.Uuid
  outcome          String   @db.VarChar(32)
  reason           String?  @db.Text
  decidedBy        String   @map("decided_by") @db.Uuid
  decidedAt        DateTime @map("decided_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  moderationCase ModerationCase? @relation(fields: [moderationCaseId], references: [id])

  // Append-only (confirmed) — no updated_at/version. Index backs the
  // "latest_moderation_decision" per-entity lookup T-G2-3's product/variant
  // detail payload resolves against (not a stored column).
  @@index([entityType, entityId])
  @@map("moderation_decisions")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Catalog bulk import (T-G2-8, EXT-005's state machine). New, additive
// migration per this ticket's own text (the one G2 ticket besides T-G2-1
// allowed its own migration — catalog_import_jobs/rows/errors aren't in
// TZ §07's M03 table list). Field list per api-contract-g2.md's T-G2-8
// section, with two gap-fills flagged in the implementation report:
//   - duplicate_of_job_id: the contract's own field-reference list for
//     catalog_import_jobs omits this column, but the GET job response shape
//     in the same document returns `duplicate_of_job_id` and the confirm
//     endpoint's dedup description requires persisting which original job a
//     duplicate points to — added here as the only coherent reading.
//   - catalog_import_templates (EXT-005's own 4th proposed table, also
//     named in this ticket's migration note) is NOT built: no endpoint in
//     api-contract-g2.md's T-G2-8 section reads or writes it, and no
//     "Done means" acceptance line exercises templates — building it now
//     would be inventing a schema for an unspecified, untested admin feature
//     (EXT-005's "Super Admin controls: file limit, templates, rate limits,
//     job pause" is never wired to a route in this contract).
enum ImportJobStatus {
  UPLOADED
  VALIDATING
  READY
  IMPORTING
  COMPLETED
  PARTIAL
  FAILED

  @@schema("public")
}

model CatalogImportJob {
  id               String          @id @default(uuid()) @db.Uuid
  sellerId         String          @map("seller_id") @db.Uuid
  status           ImportJobStatus @default(UPLOADED)
  objectKey        String          @map("object_key") @db.Text
  contentHash      String?         @map("content_hash") @db.VarChar(64)
  totalRows        Int?            @map("total_rows")
  validRowCount    Int?            @map("valid_row_count")
  errorRowCount    Int?            @map("error_row_count")
  duplicateOfJobId String?         @map("duplicate_of_job_id") @db.Uuid
  createdBy        String          @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  version          Int             @default(1)

  seller      Seller               @relation(fields: [sellerId], references: [id])
  duplicateOf CatalogImportJob?    @relation("CatalogImportJobDuplicate", fields: [duplicateOfJobId], references: [id])
  duplicates  CatalogImportJob[]   @relation("CatalogImportJobDuplicate")
  rows        CatalogImportRow[]
  errors      CatalogImportError[]

  // (seller_id, content_hash) partial-unique dedup index (contract: enforced
  // only where content_hash IS NOT NULL AND status != 'FAILED') is not
  // expressible as a Prisma @@unique (no WHERE clause support in the schema
  // DSL) — added via raw SQL in this migration's migration.sql, same pattern
  // as seller_offers.price_minor's CHECK constraint in migration 0008.
  @@index([sellerId, status])
  @@map("catalog_import_jobs")
  @@schema("public")
}

model CatalogImportRow {
  id            String   @id @default(uuid()) @db.Uuid
  jobId         String   @map("job_id") @db.Uuid
  rowNumber     Int      @map("row_number")
  action        String   @db.VarChar(32)
  sellerOfferId String?  @map("seller_offer_id") @db.Uuid
  productId     String?  @map("product_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  job         CatalogImportJob @relation(fields: [jobId], references: [id])
  sellerOffer SellerOffer?     @relation(fields: [sellerOfferId], references: [id])
  product     Product?         @relation(fields: [productId], references: [id])

  // Append-only (confirmed by api-contract-g2.md: "written once at commit")
  // — no updated_at/version.
  @@index([jobId])
  @@map("catalog_import_rows")
  @@schema("public")
}

model CatalogImportError {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  rowNumber Int      @map("row_number")
  field     String   @db.VarChar(64)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  job CatalogImportJob @relation(fields: [jobId], references: [id])

  // Append-only (confirmed) — no updated_at/version.
  @@index([jobId, createdAt])
  @@map("catalog_import_errors")
  @@schema("public")
}
